{
  "format": "megane-project",
  "version": 1,
  "app_version": "0.4.0",
  "settings": {
    "sample_rate": 48000.0,
    "precision": "fp32",
    "use_gpu": false,
    "output_dir": "output"
  },
  "nodes": [
    {
      "type": "image_input",
      "id": "image",
      "params": {
        "path": "",
        "normalize": true
      }
    },
    {
      "type": "split",
      "id": "split",
      "params": {
        "mode": "channels"
      }
    },
    {
      "type": "raster_scan",
      "id": "s1",
      "params": {
        "axis": "column",
        "channel": "luminance",
        "reduction": "mean",
        "direction": "forward"
      }
    },
    {
      "type": "oscillator",
      "id": "o1",
      "params": {
        "input_range": "data_range",
        "pitch_mode": "scale",
        "f_min": 110.0,
        "f_max": 1760.0,
        "curve": "log",
        "root_midi": 36,
        "scale": "pentatonic",
        "octaves": 4,
        "notes": [
          60,
          62,
          64,
          67,
          69
        ],
        "waveform": "sine",
        "duration_mode": "total_seconds",
        "total_seconds": 6.0,
        "bpm": 120.0,
        "steps_per_beat": 1.0,
        "amplitude": 0.8,
        "sample_rate": 48000.0
      }
    },
    {
      "type": "raster_scan",
      "id": "s2",
      "params": {
        "axis": "column",
        "channel": "luminance",
        "reduction": "mean",
        "direction": "forward"
      }
    },
    {
      "type": "oscillator",
      "id": "o2",
      "params": {
        "input_range": "data_range",
        "pitch_mode": "scale",
        "f_min": 110.0,
        "f_max": 1760.0,
        "curve": "log",
        "root_midi": 48,
        "scale": "pentatonic",
        "octaves": 4,
        "notes": [
          60,
          62,
          64,
          67,
          69
        ],
        "waveform": "sine",
        "duration_mode": "total_seconds",
        "total_seconds": 6.0,
        "bpm": 120.0,
        "steps_per_beat": 1.0,
        "amplitude": 0.8,
        "sample_rate": 48000.0
      }
    },
    {
      "type": "raster_scan",
      "id": "s3",
      "params": {
        "axis": "column",
        "channel": "luminance",
        "reduction": "mean",
        "direction": "forward"
      }
    },
    {
      "type": "oscillator",
      "id": "o3",
      "params": {
        "input_range": "data_range",
        "pitch_mode": "scale",
        "f_min": 110.0,
        "f_max": 1760.0,
        "curve": "log",
        "root_midi": 60,
        "scale": "pentatonic",
        "octaves": 4,
        "notes": [
          60,
          62,
          64,
          67,
          69
        ],
        "waveform": "sine",
        "duration_mode": "total_seconds",
        "total_seconds": 6.0,
        "bpm": 120.0,
        "steps_per_beat": 1.0,
        "amplitude": 0.8,
        "sample_rate": 48000.0
      }
    },
    {
      "type": "mix",
      "id": "mix",
      "params": {
        "gain_a": 1.0,
        "gain_b": 1.0,
        "gain_c": 1.0,
        "gain_d": 1.0,
        "normalize": true
      }
    },
    {
      "type": "audio_output",
      "id": "wav",
      "params": {
        "filename": "rgb_trio.wav",
        "directory": "",
        "subtype": "PCM_16",
        "normalize": false
      }
    }
  ],
  "connections": [
    [
      "image",
      "image",
      "split",
      "image"
    ],
    [
      "split",
      "p1",
      "s1",
      "image"
    ],
    [
      "s1",
      "values",
      "o1",
      "values"
    ],
    [
      "split",
      "p2",
      "s2",
      "image"
    ],
    [
      "s2",
      "values",
      "o2",
      "values"
    ],
    [
      "split",
      "p3",
      "s3",
      "image"
    ],
    [
      "s3",
      "values",
      "o3",
      "values"
    ],
    [
      "o1",
      "audio",
      "mix",
      "a"
    ],
    [
      "o2",
      "audio",
      "mix",
      "b"
    ],
    [
      "o3",
      "audio",
      "mix",
      "c"
    ],
    [
      "mix",
      "audio",
      "wav",
      "audio"
    ]
  ],
  "assets": {},
  "ui": {
    "positions": {
      "image": [
        -700,
        0
      ],
      "split": [
        -440,
        0
      ],
      "s1": [
        -180,
        -160
      ],
      "s2": [
        -180,
        0
      ],
      "s3": [
        -180,
        160
      ],
      "o1": [
        80,
        -160
      ],
      "o2": [
        80,
        0
      ],
      "o3": [
        80,
        160
      ],
      "mix": [
        360,
        0
      ],
      "wav": [
        620,
        0
      ]
    }
  }
}